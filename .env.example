POSTGRES_DB=wordinary
POSTGRES_USER=wordinary
POSTGRES_PASSWORD=wordinary
DATABASE_URL=postgresql+asyncpg://wordinary:wordinary@db:5432/wordinary
AUTH_SECRET_KEY=change-me-to-a-long-random-local-secret
ACCESS_TOKEN_EXPIRES_SECONDS=604800
BACKEND_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8787,http://127.0.0.1:8787
APP_NAME=Wordinary API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
STORAGE_BACKEND=minio
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=wordinary
STORAGE_SECRET_KEY=wordinary-local-minio-secret
STORAGE_BUCKET=wordinary-dev
STORAGE_REGION=us-east-1
STORAGE_PRESIGNED_EXPIRES_SECONDS=900
YOUTUBE_COOKIES_DIR=./youtube-cookies
WORDINARY_COOKIES_FILE=/run/wordinary/youtube-cookies/cookies.txt
OPENAI_API_KEY=
OPENAI_BASE_URL=
WODY_MODEL=gpt-5-mini
WODY_TEMPERATURE=0.5
WODY_TIMEOUT_SECONDS=45
JINA_API_KEY=
JINA_TIMEOUT_SECONDS=25
JINA_MAX_TOKENS=2500
