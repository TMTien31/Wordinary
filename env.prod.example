IMAGE_TAG=latest

APP_NAME=Wordinary API
API_V1_PREFIX=/api/v1
ENVIRONMENT=production
BACKEND_CORS_ORIGINS=https://wordinary.tmt-ai.uk

POSTGRES_DB=wordinary
POSTGRES_USER=wordinary
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DATABASE_URL=postgresql+asyncpg://wordinary:replace-with-a-strong-postgres-password@db:5432/wordinary

AUTH_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_SECONDS=604800

STORAGE_BACKEND=minio
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_ENDPOINT_URL=
STORAGE_ACCESS_KEY=replace-with-a-minio-user
STORAGE_SECRET_KEY=replace-with-a-strong-minio-password
STORAGE_BUCKET=wordinary-prod
STORAGE_REGION=us-east-1
STORAGE_PRESIGNED_EXPIRES_SECONDS=900

FRONTEND_PORT=5500
API_WORKERS=2
