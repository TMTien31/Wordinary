*.sqlite
*.sqlite3
*.db
*.log
*.tmp
.tmp/
.codex_tmp/
.pytest-caption-temp/
pytest-cache-files-*/

# Frontend dependencies/build output
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
coverage/
